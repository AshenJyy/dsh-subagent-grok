{
  "name": "dsh-subagent-grok",
  "version": "0.1.0",
  "description": "One-shot Grok Build subagent provider for DeepSeek Harness 0.2.2-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src",
    "scripts/build.mjs",
    "types",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshenJyy/dsh-subagent-grok.git"
  },
  "homepage": "https://github.com/AshenJyy/dsh-subagent-grok#readme",
  "bugs": {
    "url": "https://github.com/AshenJyy/dsh-subagent-grok/issues"
  },
  "keywords": ["dsh", "deepseek-harness", "grok", "subagent"],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pack": "npm run build && npm pack --ignore-scripts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.3",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.2.2-rc.3",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-tool-subagent": "0.2.2-rc.3"
  }
}

